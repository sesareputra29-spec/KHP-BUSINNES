# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (LOCAL & VERCEL PRODUCTION)
# ============================================================================

# 1. APPLICATION & SERVER RUNTIME
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# 2. EXTERNAL PERSISTENT DATABASE (Required for Vercel Production)
# Target: PostgreSQL connection string from Neon, Supabase, Vercel Postgres, AWS RDS, or Cloud SQL
# Example: postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# 3. SESSION, CRON & SECURITY CREDENTIALS
SESSION_SECRET="your-secure-random-session-secret-change-in-production"
CRON_SECRET="your-random-secret-key-for-vercel-cron-authorization"
SUPERADMIN_EMAIL="superadmin@hppsaas.com"
SUPERADMIN_PASSWORD="YourStrongSuperAdminPassword123!"

# 4. PAYMENT GATEWAY & WEBHOOK CONFIGURATION (Production)
# Example: Midtrans, Xendit, or Stripe Server Key & Webhook Signature Secret
PAYMENT_GATEWAY_PROVIDER="MOCK" # Set to "MIDTRANS" or "XENDIT" for live
PAYMENT_GATEWAY_SERVER_KEY=""
PAYMENT_GATEWAY_CLIENT_KEY=""
WEBHOOK_SECRET="your-live-payment-gateway-webhook-signing-secret"

# 5. TRANSACTIONAL EMAIL SERVICE (SMTP / Provider)
# Example: Resend, SendGrid, Mailgun, Amazon SES, or Custom SMTP
EMAIL_FROM="Kalkulator HPP SaaS <no-reply@hppsaas.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# 6. EXTERNAL OBJECT / BLOB STORAGE (For uploaded invoices, receipts, attachments)
# Example: Vercel Blob, AWS S3, Cloudflare R2, or Google Cloud Storage
BLOB_READ_WRITE_TOKEN=""
STORAGE_BUCKET_URL=""

# 7. AI & EXTERNAL APIS (If enabled)
GEMINI_API_KEY=""

