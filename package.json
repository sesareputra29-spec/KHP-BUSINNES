{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild src/server/app.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --packages=external",
    "build": "vite build && esbuild src/server/app.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --packages=external",
    "preview": "vite preview",
    "db:migrate": "tsx src/server/scripts/migrate-pg.ts",
    "test:prod": "tsx tests/production-suite.ts",
    "clean": "rm -rf dist server.js api/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-joyride": "^3.2.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
